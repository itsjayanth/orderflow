{
  "version": "6.0",
  "data_api_version": "3.0",
  "routing_model": {
    "BOOKING": []
  },
  "screens": [
    {
      "id": "BOOKING",
      "title": "Book an appointment",
      "terminal": true,
      "success": true,
      "data": {
        "business_name": {
          "type": "string",
          "__example__": "Varkey's"
        },
        "date_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "2026-08-28",
              "title": "Fri, 28 Aug"
            },
            {
              "id": "2026-08-29",
              "title": "Sat, 29 Aug"
            }
          ]
        },
        "time_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "09:00",
              "title": "9:00 AM"
            },
            {
              "id": "09:30",
              "title": "9:30 AM"
            }
          ]
        },
        "saved_customer_name": {
          "type": "string",
          "__example__": "Asha"
        },
        "saved_customer_email": {
          "type": "string",
          "__example__": "asha@example.com"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.business_name}"
          },
          {
            "type": "TextBody",
            "text": "Pick a date and time that works for you."
          },
          {
            "type": "Form",
            "name": "booking_form",
            "init-values": {
              "customer_name": "${data.saved_customer_name}",
              "customer_email": "${data.saved_customer_email}"
            },
            "children": [
              {
                "type": "Dropdown",
                "name": "appointment_date",
                "label": "Date",
                "data-source": "${data.date_options}",
                "required": true
              },
              {
                "type": "Dropdown",
                "name": "appointment_time",
                "label": "Time",
                "data-source": "${data.time_options}",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "customer_name",
                "label": "Your name",
                "input-type": "text",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "customer_email",
                "label": "Email address",
                "input-type": "email",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "notes",
                "label": "Anything we should know? (optional)",
                "input-type": "text",
                "required": false
              },
              {
                "type": "Footer",
                "label": "Request appointment",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "appointment_date": "${form.appointment_date}",
                    "appointment_time": "${form.appointment_time}",
                    "customer_name": "${form.customer_name}",
                    "customer_email": "${form.customer_email}",
                    "notes": "${form.notes}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
