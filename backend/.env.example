ENV=development

DATABASE_URL=postgresql+asyncpg://orderflow:orderflow@localhost:5432/orderflow

# No default -- the app fails closed (raises) if this is unset. Generate
# a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Fernet key for encrypting stored secrets (e.g. WhatsApp access tokens).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Razorpay and WhatsApp credentials are entered per-merchant on the
# dashboard's Settings page, not configured here.

# Fallback HMAC secret DummyPaymentGateway uses to verify /test-checkout
# webhook signatures before a merchant configures real Razorpay credentials
# (entered per-merchant via the dashboard's Settings page, never here).
# PLACEHOLDER -- leave unset for now; a random secret is generated at
# process startup if this isn't set. Set it only if you need dummy webhook
# signatures to stay valid across restarts/multiple workers.
PAYMENTS_DUMMY_GATEWAY_SECRET=

WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v20.0
# Shared secret for Meta's webhook verification handshake -- set this to
# whatever you configure as the "Verify token" in the Meta App dashboard.
# No default -- the GET handshake fails closed if this is unset.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta Embedded Signup ("Connect your WhatsApp Business account" button,
# onboarding/domain/embedded_signup.py) -- one Meta App backs every
# merchant. Leave unset to keep the manual-entry-only onboarding path;
# the frontend hides the connect button and this backend endpoint fails
# fast with a clear error rather than a confusing Meta 4xx.
# Get these from the Meta App Dashboard for the app you're using for
# orderflow -- see the frontend .env.example for the matching VITE_ vars
# the browser needs, and the project README for what must be configured
# in the dashboard itself (Facebook Login for Business config, allowed
# JS SDK domains, App Review permissions).
META_APP_ID=
# Also required to verify the X-Hub-Signature-256 header on every inbound
# /api/v1/whatsapp/webhook POST (conversation/api/router.py) -- without
# it, that endpoint rejects all POSTs with 503 rather than trusting an
# unverifiable body.
META_APP_SECRET=
META_ES_CONFIG_ID=
META_GRAPH_API_VERSION=v22.0

# shared/interaction_mode.py -- WHATSAPP_FLOW (native in-chat Flow, default)
# or BROWSER_LINK (interactive CTA-URL button linking to the hosted web page
# instead -- no Meta template approval needed, sent within the customer's
# session window). Invalid/unset falls back to WHATSAPP_FLOW with a logged
# warning.
INTERACTION_MODE=WHATSAPP_FLOW

# Appointment reminders (shared/scheduler.py's send_due_appointment_reminders)
# -- genuinely needs a Meta-approved WhatsApp template (with positional
# {{1}}, {{2}}, ... body variables), unlike the CTA-URL button above, since
# a reminder is sent hours later, outside the customer's session window.
# Unset = reminder scan no-ops for every merchant, safe default.
WHATSAPP_APPOINTMENT_REMINDER_TEMPLATE_NAME=
WHATSAPP_APPOINTMENT_REMINDER_LANGUAGE_CODE=en_US

# Where the customer-facing ordering webview lives, for links the bot
# sends in-chat.
FRONTEND_BASE_URL=http://localhost:5173

ABANDONED_ORDER_TIMEOUT_MINUTES=30

CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Platform Razorpay account for merchant subscription billing (billing/) --
# separate from the per-merchant Razorpay credentials entered on the
# dashboard's Payments settings page (payments/). Exactly one platform
# account bills every merchant for their Starter/Growth/Pro plan. Leave
# PLATFORM_RAZORPAY_KEY_ID unset to use DummyBillingGateway (no real
# network calls, real HMAC webhook verification against the secret below).
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
# Dedicated webhook secret for Razorpay's Subscriptions webhooks --
# deliberately separate from the API key secret above (the real Razorpay
# pattern). PLACEHOLDER -- leave unset for now; a random secret is
# generated at process startup so this can't be guessed from the source
# code. Replace with the real webhook secret from Razorpay's dashboard once
# PLATFORM_RAZORPAY_KEY_ID/_SECRET are configured for production -- see
# shared/config.py's Settings.platform_razorpay_webhook_secret.
PLATFORM_RAZORPAY_WEBHOOK_SECRET=

TRIAL_PERIOD_DAYS=14
BILLING_PAST_DUE_GRACE_DAYS=4
