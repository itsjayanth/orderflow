VITE_API_URL=https://orderflow-api-sandbox.up.railway.app

# Meta Embedded Signup -- OrdzoLive app, dedicated "Orderflow Embedded
# Signup v2" Facebook Login for Business configuration (recreated
# 2026-08-30 from Meta's WhatsApp Embedded Signup template -- the
# original config had the "General" login variation, which has no
# WhatsApp Business Account asset option and hits Meta error #1690130
# ("<business_id> isn't a valid Business ID") at the WABA-attachment
# step. Same root cause/fix fastflow already hit on this same Meta App).
VITE_META_APP_ID=1012236041846794
VITE_META_ES_CONFIG_ID=2095824314380999

# "Return to WhatsApp" on the ordering/booking confirmation screens.
# Set to false to drop the automatic navigation and leave only the manual
# "Tap here to return to WhatsApp" button -- the revert switch for when
# a WhatsApp app update changes in-app browser redirect behaviour. Kept
# here explicitly, rather than relying on the code default, so reverting
# is editing a value that already exists instead of remembering the name.
VITE_WHATSAPP_RETURN_REDIRECT=true
VITE_WHATSAPP_RETURN_DELAY_MS=2000
