VITE_API_URL=http://localhost:8000

# Meta Embedded Signup ("Connect your WhatsApp Business account" button).
# Leave both blank to keep the manual phone_number_id/access_token entry
# as the only onboarding path -- the button hides itself when either is
# unset. Get these from the Meta App Dashboard for whichever Meta App
# backs orderflow's WhatsApp connection (Facebook Login for Business
# product -> Configurations for VITE_META_ES_CONFIG_ID; App Settings ->
# Basic for VITE_META_APP_ID). Not secrets -- safe to expose to the
# browser (never put the App Secret here; that's backend-only, see
# backend/.env.example's META_APP_SECRET).
VITE_META_APP_ID=
VITE_META_ES_CONFIG_ID=
