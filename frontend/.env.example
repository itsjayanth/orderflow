VITE_API_URL=http://localhost:8000

# Meta Embedded Signup ("Connect your WhatsApp Business account" button).
# Leave both blank to keep the manual phone_number_id/access_token entry
# as the only onboarding path -- the button hides itself when either is
# unset. Get these from the Meta App Dashboard for whichever Meta App
# backs orderflow's WhatsApp connection (Facebook Login for Business
# product -> Configurations for VITE_META_ES_CONFIG_ID; App Settings ->
# Basic for VITE_META_APP_ID). Not secrets -- safe to expose to the
# browser (never put the App Secret here; that's backend-only, see
# backend/.env.example's META_APP_SECRET).
VITE_META_APP_ID=
VITE_META_ES_CONFIG_ID=

# "Return to WhatsApp" on the ordering/booking confirmation screens.
# When enabled (the default -- anything other than false/0/off/no), the
# confirmation screen waits VITE_WHATSAPP_RETURN_DELAY_MS and then
# navigates to the merchant's wa.me link, which on most WhatsApp in-app
# browser builds drops the customer back into the chat. Meta documents
# none of this and the behaviour differs by app version and platform, so
# a manual "Tap here to return to WhatsApp" button is always rendered
# alongside; set the flag to false to keep that button and drop the
# automatic navigation entirely. Orders still awaiting payment never
# auto-redirect regardless -- they'd be pulled off their payment link.
VITE_WHATSAPP_RETURN_REDIRECT=true
VITE_WHATSAPP_RETURN_DELAY_MS=2000
